{
  "pkg": "@claude-design/dashboard-ui",
  "globalName": "DashboardUI",
  "projectId": "e2a137c1-dd8c-43b4-b229-aded5905f46f",
  "shape": "package",
  "buildCmd": "npx tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist/types && .design-sync/build-css.sh",
  "srcDir": "src",
