{
  "pkg": "@claude-design/dashboard-ui",
  "globalName": "DashboardUI",
  "projectId": "e2a137c1-dd8c-43b4-b229-aded5905f46f",
  "shape": "package",
  "buildCmd": "npx tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist/types && .design-sync/build-css.sh",
  "srcDir": "src",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".design-sync/.cache/ds.css",
  "docsDir": ".design-sync/docs",
  "readmeHeader": ".design-sync/conventions.md",
  "extraFonts": [".design-sync/fonts/inter.css"],
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "760x520" },
    "AlertDialog": { "cardMode": "single", "viewport": "760x520" },
    "Select": { "cardMode": "single", "viewport": "560x480" },
    "DropdownMenu": { "cardMode": "single", "viewport": "560x480" },
    "Toaster": { "cardMode": "single", "viewport": "720x440" },
    "AppShell": { "cardMode": "single", "viewport": "1240x780" },
    "Pagination": { "cardMode": "column" },
    "Table": { "cardMode": "column" },
    "LoginForm": { "cardMode": "column" },
    "PageHeader": { "cardMode": "column" },
    "SummaryCard": { "cardMode": "column" },
    "ChartContainer": { "cardMode": "column" }
  },
  "componentSrcMap": {
    "Alert": "src/components/ui/alert.tsx",
    "AlertDialog": "src/components/ui/alert-dialog.tsx",
    "Badge": "src/components/ui/badge.tsx",
    "Button": "src/components/ui/button.tsx",
    "Card": "src/components/ui/card.tsx",
    "Checkbox": "src/components/ui/checkbox.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "DropdownMenu": "src/components/ui/dropdown-menu.tsx",
    "Field": "src/components/ui/field.tsx",
    "Input": "src/components/ui/input.tsx",
    "Label": "src/components/ui/label.tsx",
    "Pagination": "src/components/ui/pagination.tsx",
    "RadioGroup": "src/components/ui/radio-group.tsx",
    "Select": "src/components/ui/select.tsx",
    "Skeleton": "src/components/ui/skeleton.tsx",
    "Switch": "src/components/ui/switch.tsx",
    "Table": "src/components/ui/table.tsx",
    "Textarea": "src/components/ui/textarea.tsx",
    "Toaster": "src/components/ui/sonner.tsx",
    "AppShell": "src/components/dashboard/app-shell.tsx",
    "ChartContainer": "src/components/dashboard/chart-container.tsx",
    "LoginForm": "src/components/dashboard/login-form.tsx",
    "PageHeader": "src/components/dashboard/page-header.tsx",
    "SummaryCard": "src/components/dashboard/summary-card.tsx"
  }
}
